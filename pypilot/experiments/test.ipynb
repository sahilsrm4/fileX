   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "project:\n",
      "  name: \"Autonomous Test Automation Project\"\n",
      "  language: \"python\"\n",
      "  test_framework: \"pytest\"\n",
      "  ui_framework: \"playwright\"\n",
      "  api_framework: \"requests\"\n",
      "  \n",
      "folder_structure:\n",
      "  tests:\n",
      "    purpose: \"Contains executable test cases\"\n",
      "    \n",
      "  tests/ui:\n",
      "    purpose: \"UI and browser automation tests\"\n",
      "    \n",
      "  tests/api:\n",
      "    purpose: \"API test cases\"\n",
      "    \n",
      "  tests/integration:\n",
      "    purpose: \"End-to-end and integration scenarios\"\n",
      "    \n",
      "  pages:\n",
      "    purpose: \"Page Object Model classes\"\n",
      "    \n",
      "  data:\n",
      "    purpose: \"Test data and API payloads\"\n",
      "    \n",
      "  utils:\n",
      "    purpose: \"Reusable utilities and helpers\"\n",
      "    \n",
      "  config:\n",
      "    purpose: \"Environment and framework configuration\"\n",
      "    \n",
      "  reports:\n",
      "    purpose: \"Generated test reports\"\n",
      "    \n",
      "  screenshots:\n",
      "    purpose: \"Screenshots captured during failures\"\n",
      "\n",
      "rules:\n",
      "\n",
      "  test_naming:\n",
      "    test_files: \"test_<feature>.py\"\n",
      "    test_functions: \"test_<scenario>\"\n",
      "    page_objects: \"<page_name>_page.py\"\n",
      "\n",
      "  test_design:\n",
      "    - \"Each test should validate one clear behavior.\"\n",
      "    - \"Tests should be independent.\"\n",
      "    - \"Avoid unnecessary test dependencies.\"\n",
      "    - \"Use meaningful test names.\"\n",
      "    - \"Use assertions to validate expected behavior.\"\n",
      "    - \"Do not hardcode environment-specific values.\"\n",
      "\n",
      "  playwright:\n",
      "    - \"Use Page Object Model for reusable page interactions.\"\n",
      "    - \"Prefer stable locators.\"\n",
      "    - \"Prefer get_by_role, get_by_label and get_by_test_id.\"\n",
      "    - \"Avoid fragile XPath selectors when possible.\"\n",
      "    - \"Do not use fixed sleep unless absolutely necessary.\"\n",
      "    - \"Use Playwright auto-waiting.\"\n",
      "    - \"Capture screenshots on failure.\"\n",
      "\n",
      "  pytest:\n",
      "    - \"Use fixtures for reusable setup and teardown.\"\n",
      "    - \"Use conftest.py for shared fixtures.\"\n",
      "    - \"Use parametrization for data-driven tests.\"\n",
      "    - \"Keep test logic inside test files.\"\n",
      "    - \"Keep reusable actions inside page objects or utilities.\"\n",
      "\n",
      "  api:\n",
      "    - \"Keep API clients separate from test cases.\"\n",
      "    - \"Store reusable payloads in data/payloads.\"\n",
      "    - \"Validate status codes.\"\n",
      "    - \"Validate important response fields.\"\n",
      "    - \"Test positive and negative scenarios.\"\n",
      "\n",
      "  test_data:\n",
      "    - \"Do not hardcode credentials in test files.\"\n",
      "    - \"Keep reusable test data under data/test_data.\"\n",
      "    - \"Keep API payloads under data/payloads.\"\n",
      "    - \"Use environment variables for secrets.\"\n",
      "\n",
      "  reporting:\n",
      "    - \"Generate reports under reports/.\"\n",
      "    - \"Store execution logs under logs/.\"\n",
      "    - \"Store failure screenshots under screenshots/.\"\n",
      "\n",
      "  code_quality:\n",
      "    - \"Avoid duplicated code.\"\n",
      "    - \"Use descriptive variable names.\"\n",
      "    - \"Keep functions small and focused.\"\n",
      "    - \"Follow PEP8.\"\n",
      "    - \"Do not create unnecessary abstractions.\"\n",
      "\n",
      "  security:\n",
      "    - \"Never store passwords or API keys in source code.\"\n",
      "    - \"Never commit secrets.\"\n",
      "    - \"Use environment variables for sensitive values.\"\n",
      "    - \"Do not expose authentication tokens in logs.\"\n",
      "\n",
      "agent_behavior:\n",
      "\n",
      "  before_creating_files:\n",
      "    - \"Inspect the existing project structure.\"\n",
      "    - \"Reuse existing utilities and page objects.\"\n",
      "    - \"Do not create duplicate files unnecessarily.\"\n",
      "\n",
      "  before_creating_tests:\n",
      "    - \"Understand the feature implementation.\"\n",
      "    - \"Identify relevant UI/API components.\"\n",
      "    - \"Identify existing tests.\"\n",
      "    - \"Reuse existing fixtures.\"\n",
      "    - \"Identify available test data.\"\n",
      "\n",
      "  after_creating_tests:\n",
      "    - \"Run the generated tests.\"\n",
      "    - \"Analyze failures.\"\n",
      "    - \"Fix generated tests when appropriate.\"\n",
      "    - \"Re-run failed tests.\"\n",
      "    - \"Do not modify application source code without explicit approval.\"\n",
      "\n",
      "  folder_rules:\n",
      "    - \"Follow the defined project structure.\"\n",
      "    - \"Do not create random folders.\"\n",
      "    - \"Place each file in the directory matching its responsibility.\"\n",
      "\n",
      "execution:\n",
      "  command_timeout: 120\n",
      "  max_test_retries: 2\n",
      "  screenshot_on_failure: true\n"
     ]
    }
   ],
   "source": [
    "with open(\"../pypilot_rules_and_policies/folder_structure.yaml\",\"r\") as f:\n",
    "    print(f.read())"
   ]
